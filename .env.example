# Copy to .env and adjust. Nothing here is secret: Ollama runs locally.

# ─── Ollama (OpenAI-compatible endpoint) ──────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# ─── Local models per agent ───────────────────────────────────────────────────
# phi3 does NOT support Ollama tool calls: use mistral, llama3.2 or qwen2.5.
MODEL_GENERATOR=mistral
MODEL_EXECUTOR=mistral
MODEL_EVALUATOR=llama3.2
MODEL_REPORTER=mistral

# ─── Target app (fictional TechShop chatbot, target_app/) ─────────────────────
AGENT_API_URL=http://localhost:8000/chat
AGENT_WEB_URL=http://localhost:8000
AGENT_HEALTH_URL=http://localhost:8000/health

# ─── Mobile channel (Appium + Android emulator) ───────────────────────────────
APPIUM_SERVER_URL=http://localhost:4723
ANDROID_DEVICE_NAME=emulator-5554
APP_PACKAGE=com.techshop.chatbot
APP_ACTIVITY=.ui.ChatActivity

# ─── Quality thresholds ───────────────────────────────────────────────────────
MAX_LATENCY_MS=30000
MIN_SCORE_PASS=3.0
MAX_WEB_MOBILE_DIVERGENCE=0.20

# ─── Optional ─────────────────────────────────────────────────────────────────
# PLAYWRIGHT_HEADLESS=false              # watch the browser during Web tests
# NLI_MODEL_NAME=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
# AGENTIC_TESTING_ROOT=/path/to/repo     # only if the package is installed outside the repo
